meta {
  name: 02 - Obtener Pedido
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/pedidos/{{pedidoId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
  res.body.estado: eq CREADO
}

script:pre-request {
  // Sin pedidos no hay nada que consultar: se omite este request en vez de fallar.
  if (!bru.getVar("pedidoId")) {
    bru.runner.skipRequest();
  }
}

docs {
  Consulta el primer pedido devuelto por "01 - Listar Mis Pedidos" (variable
  `pedidoId`). Si el usuario no tiene pedidos, se omite: para crear uno corre
  "13 - Iniciar Checkout" de la coleccion Carrito.
}
